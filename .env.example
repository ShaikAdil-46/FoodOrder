# Copy to .env and replace every placeholder before using Docker Compose.
MYSQL_DATABASE=foodorder
MYSQL_USER=foodorder
MYSQL_PASSWORD=replace-with-a-strong-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password

# Use a randomly generated value of at least 32 bytes.
JWT_SECRET=replace-with-at-least-32-random-secret-bytes-for-local-development

# Optional: bootstrap an administrator on first application start.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
SERVER_PORT=8090
